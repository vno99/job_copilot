AIRFLOW_UID=197608
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=
AIRFLOW_POSTGRES_DB=airflow

_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=

JOB_COPILOT_POSTGRES_USER=user
# Doit rester NON VIDE : la base applicative (service postgres-data du
# docker-compose) défaut sur `password` — les URLs ci-dessous l'interpolent.
# À changer en production.
JOB_COPILOT_POSTGRES_PASSWORD=password
JOB_COPILOT_POSTGRES_DB=job_copilot

# DB applicative locale (service postgres-data du docker-compose, port 5434).
# En conteneur Airflow, l'hôte devient "postgres-data" sur le port 5432.
DATABASE_URL=postgresql+psycopg2://${JOB_COPILOT_POSTGRES_USER}:${JOB_COPILOT_POSTGRES_PASSWORD}@localhost:5434/${JOB_COPILOT_POSTGRES_DB}
DOCKER_DATABASE_URL=postgresql+psycopg2://${JOB_COPILOT_POSTGRES_USER}:${JOB_COPILOT_POSTGRES_PASSWORD}@postgres-data:5432/${JOB_COPILOT_POSTGRES_DB}

PYTHONPATH=C:\Workspace\job_copilot
# OpenRouter API key (remplace MISTRAL_API_KEY).
# Obtenez une clé sur https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=
# Modèle small (extraction, matching, lettre pass 1) — défaut : mistral/mistral-small-latest
OPENROUTER_LLM_MODEL_SMALL=
# Modèle large (génération CV, réécriture lettre) — défaut : mistral/mistral-large-latest
OPENROUTER_LLM_MODEL_LARGE=

# --- Clés secrètes Airflow (obligatoires, jamais commitées) ---
# Utilisées par docker-compose (AIRFLOW__*__*). Une clé absente bloque le
# démarrage (docker compose échoue explicitement). Régénérer localement :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__API__SECRET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=